# Public URL chosen by Oduflow/Traefik for the `inbox-zero` service.
INBOX_ZERO_BASE_URL=https://inbox-zero.example.com

# Admit exactly one account to this personal deployment.
INBOX_ZERO_OWNER_EMAIL=you@example.com

# Google OAuth + Gmail push notifications.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=secret:zeroinbox-google-client-secret
GOOGLE_PUBSUB_TOPIC_NAME=projects/example/topics/inbox-zero
GOOGLE_PUBSUB_VERIFICATION_TOKEN=secret:zeroinbox-google-pubsub-token

# Redis is private on the team network. Change `1` to the --team value used
# when applying the stack. The same named secret authenticates Redis and its
# HTTP bridge; create it in Oduflow before applying.
REDIS_HOST=oduflow-1-svc-inbox-zero-redis
UPSTASH_REDIS_URL=http://oduflow-1-svc-inbox-zero-redis-http:80
REDIS_TOKEN=secret:zeroinbox-redis-token

# Optional Telegram channel. Both values are required together.
TELEGRAM_BOT_TOKEN=secret:zeroinbox-telegram-bot-token
TELEGRAM_BOT_SECRET_TOKEN=secret:zeroinbox-telegram-webhook-secret

# OpenAI-compatible endpoint such as a private LiteLLM proxy. The model must
# be the exact alias exposed by that proxy's /v1/models endpoint.
DEFAULT_LLM_PROVIDER=openai-compatible
DEFAULT_LLM_MODEL=gpt-6.1-sol
OPENAI_COMPATIBLE_BASE_URL=https://litellm.example.com/v1
LLM_API_KEY=secret:zeroinbox-litellm-key
