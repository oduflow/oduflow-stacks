# Comma-separated email addresses allowed to create accounts.
MULTICA_ALLOWED_EMAILS=owner@example.com
# SMTP account for verification codes. Set the password in Oduflow team secrets.
MULTICA_SMTP_HOST=smtp.example.com
MULTICA_SMTP_PORT=587
MULTICA_SMTP_USERNAME=notifications@example.com
MULTICA_SMTP_FROM_EMAIL=notifications@example.com
